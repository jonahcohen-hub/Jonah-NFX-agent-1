# Anthropic API key used to run the agent's conversation/tool loop.
ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-sonnet-5).
# ANTHROPIC_MODEL=claude-sonnet-5

# Comma-separated list of phone numbers (with country code, no "+" or spaces,
# e.g. 15551234567) allowed to talk to the agent. Leave empty to allow anyone
# who messages the number (not recommended).
ALLOWED_NUMBERS=

# Optional: only needed for pairing on a host with no camera-friendly QR
# display (e.g. Railway logs). Set to the WhatsApp number that will run the
# agent (country code, no "+"), and a pairing code will be printed in the
# logs on first run instead of a QR code. Leave unset to use the QR flow.
# PAIRING_PHONE_NUMBER=
