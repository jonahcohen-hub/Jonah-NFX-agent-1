# Anthropic API key used to run the agent's conversation/tool loop.
ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-sonnet-5).
# ANTHROPIC_MODEL=claude-sonnet-5

# Comma-separated list of people allowed to talk to the agent. Each entry is
# either a bare phone number in E.164 format (e.g. +15551234567), or
# "Name:+15551234567" to also let the agent address that person by name via
# its send_message tool (e.g. "tell Sarah I'm running late"). Leave empty to
# allow anyone who messages the number (not recommended).
# Example: ALLOWED_NUMBERS=Jonah:+15551234567,Sarah:+15559876543
ALLOWED_NUMBERS=

# --- Twilio (official WhatsApp Business API) ---
# Find these in your Twilio Console (console.twilio.com).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The WhatsApp-enabled Twilio number to send/receive from, in the form
# "whatsapp:+14155238886". Use the Sandbox number for quick testing
# (Console -> Messaging -> Try it out -> Send a WhatsApp message), or your
# own approved WhatsApp Business number once you have one.
TWILIO_WHATSAPP_NUMBER=

# Port the webhook server listens on. Railway sets this automatically;
# leave unset locally to default to 3000.
# PORT=3000

# Validates that incoming webhook requests really came from Twilio. Off by
# default to avoid signature/host mismatches while testing through ngrok -
# turn on once running somewhere with a stable public URL (e.g. Railway).
# TWILIO_VALIDATE_WEBHOOK=true
