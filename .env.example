# Anthropic API key used to run the agent's conversation/tool loop.
ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-sonnet-5).
# ANTHROPIC_MODEL=claude-sonnet-5

# Comma-separated list of people allowed to talk to the agent. Each entry is
# either a bare phone number (country code, no "+" or spaces, e.g.
# 15551234567), or "Name:number" to also let the agent address that person
# by name via its send_message tool (e.g. "tell Sarah I'm running late").
# A full JID (containing "@") also works in place of a number - see README
# for why that's sometimes needed. Leave empty to allow anyone who messages
# the number (not recommended).
# Example: ALLOWED_NUMBERS=Jonah:15551234567,Sarah:15559876543
ALLOWED_NUMBERS=

# Optional: only needed for pairing on a host with no camera-friendly QR
# display (e.g. Railway logs). Set to the WhatsApp number that will run the
# agent (country code, no "+"), and a pairing code will be printed in the
# logs on first run instead of a QR code. Leave unset to use the QR flow.
# PAIRING_PHONE_NUMBER=
